# Copia este archivo como .env, o simplemente ejecuta "npm start":
# si no existe .env, el sistema pregunta los datos y lo crea solo.

# Servidor web: puerto donde abre el sistema (NO es el puerto de MySQL)
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (MySQL 8.0.16+ o MariaDB 10.6+)
# Usa 127.0.0.1 en lugar de localhost (en algunas distros localhost va por IPv6)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Opcional en Linux/macOS: conectar por socket en lugar de TCP
DB_SOCKET=
DB_NAME=inventario_web

# Sesiones (si se deja vacío se genera uno aleatorio al arrancar)
JWT_SECRET=
JWT_EXPIRES_IN=8h
